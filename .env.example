# Root environment reference - copy to backend/.env and frontend/.env.local

# Database
DATABASE_URL=postgresql://marketplace:marketplace_secret@localhost:5432/marketplace?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies & CSRF
COOKIE_SECRET=change-me-cookie-secret-min-32-chars
CSRF_SECRET=change-me-csrf-secret-min-32-chars
NODE_ENV=development

# Server
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
CDN_URL=

# Platform
PLATFORM_COMMISSION_PERCENT=10
OTP_EXPIRES_MINUTES=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
